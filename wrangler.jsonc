{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tokens-usage",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "workers_dev": false,
  "routes": [
    { "pattern": "tokens.lkwplus.com", "custom_domain": true }
  ],
  "vars": {
    "TOKENS_USERNAME": "lkw123"
  },
  // Static homepage (architecture + API reference). Assets are matched
  // before the Worker runs, so "/" serves public/index.html and every
  // /api/* request falls through to the router as before.
  "assets": {
    "directory": "./public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tokens-usage",
      "database_id": "0e09184d-7b08-40df-90ee-34ae44477f93",
      "migrations_dir": "./migrations"
    }
  ],
  // Precomposed /api/site payload (+ its ETag in the entry metadata),
  // rewritten by every accepted submission.
  "kv_namespaces": [
    {
      "binding": "SITE_CACHE",
      "id": "13d618cc3c6642318451a8f1502630ad"
    }
  ],
  // Raw submission payloads + daily D1 exports (see src/backup.ts).
  "r2_buckets": [
    {
      "binding": "ARCHIVE",
      "bucket_name": "tokens-archive"
    }
  ],
  // No cron triggers (the account's free-plan quota of 5 is taken): the
  // KV site payload and the daily R2 backup refresh on every accepted
  // submission instead — the only event that changes the data.
  "observability": {
    "enabled": true
  }
}
