[Unit]
Description=report the Claude subscription quota to tokens.lkwplus.com
Documentation=https://github.com/synthpop123/tokens-worker
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=%h/.local/bin/report-claude-quota.py
Environment=TOKENS_API_URL=https://tokens.lkwplus.com
Environment=TZ=Asia/Shanghai
